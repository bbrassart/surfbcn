<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="900">
  <title>Swell – <%= h(station_name) %></title>
  <link id="page_favicon" rel="icon" type="image/png" href="https://mon-fisic.com/wp-content/uploads/2023/08/blue1.png">
  <style>
    body { font-family: system-ui, sans-serif; margin: 1.5rem; color: #222; }
    table { border-collapse: collapse; }
    .table-wrap { overflow-x: auto; }
    th, td { border: 1px solid #ccc; padding: 4px 10px; text-align: center; white-space: nowrap; }
    th { background: #2274a5; color: #fff; }
    tr.past { color: #aaa; }
    tr.midnight { background: #d3d3d3 }
    tr.now { background: #ceecff; font-weight: bold; }
    td.sunny { background: #ffe066; }
    td.cloudy { background: #d3d3d3; }
    td.rainy { background: #0b2e6b; color: #fff; }
    .webcam { margin-top: 1.5rem; }
    .webcam-grid { display: grid; gap: 1rem; }
    .webcam img { display: block; max-width: 100%; height: auto; }
    footer { margin-top: 1rem; font-size: 0.85rem; color: #666; }
  </style>
</head>
<body>
  <h1>Swell – <%= h(station_name) %></h1>
  <p>Updated: <%= generated_at.strftime('%Hh%M %d-%m-%Y') %></p>
  <p><strong id="sun-times" aria-live="polite">Sunrise and sunset: loading...</strong></p>
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Date/Time</th>
        <th>Wave height</th>
        <th>Groundswell Tp</th>
        <th>Short period Tm02</th>
        <th>Swell direction</th>
        <th>Wind</th>
        <th>Weather</th>
      </tr>
    </thead>
    <tbody>
<% rows.each do |row| -%>
      <tr data-epoch="<%= row.time.to_i %>" class="<%= 'midnight' if row.time.hour == 0 %>">
        <td><%= row.time.strftime('%Hh%M %d-%m-%Y') %></td>
        <td><%= format('%.2f', row.wave_height) %></td>
        <td><%= format('%.1f', row.peak_period) %></td>
        <td><%= format('%.1f', row.mean_period) %></td>
        <td title="<%= row.direction_from_degrees.round %>°"><%= row.direction %> (<%= row.direction_from_degrees.round %>°)</td>
        <td><% if row.wind_gust && row.wind_direction_degrees %><%= row.wind_gust.round %> kn <%= row.wind_direction %> (<%= row.wind_direction_degrees.round %>°)<% else %>–<% end %></td>
        <td<% if row.weather %> class="<%= row.weather %>" title="<%= PortusForecast::Weather::LABELS[row.weather] %>"<% end %>><% if row.precipitation %><%= format('%.1f', row.precipitation) %> mm<% else %>–<% end %></td>
      </tr>
<% end -%>
    </tbody>
  </table>
  </div>
  <section class="webcam">
    <h2>Webcams</h2>
    <div class="webcam-grid">
      <img src="https://www.bcasa.cat:8888/imatgesaraplatgesbcn/camara6.jpg"
           alt="Live webcam view of the beach (camera 6)" loading="lazy">
      <img src="https://www.bcasa.cat:8888/imatgesaraplatgesbcn/camara1.jpg"
           alt="Live webcam view of the beach (camera 1)" loading="lazy">
    </div>
    <p><a href="http://cnbadalona.cat/cam/garbi.php" target="_blank" rel="noopener">Badalona webcam (Club Natació Badalona) ↗</a></p>
  </section>
  <footer>
    Source: <a href="https://portus.puertos.es/">Puertos del Estado – Portus</a>.
    Webcams: <a href="https://www.bcasa.cat/">Barcelona Cicle de l'Aigua (BCASA)</a>.
    Wind, weather and rain (Playa del Bogatell): <a href="https://open-meteo.com/">Weather data by Open-Meteo.com</a>
  </footer>
  <script>
    fetch('https://api.sunrise-sunset.org/v2?lat=41.3851&lng=2.1734')
      .then(function (response) {
        if (!response.ok) throw new Error('Sunrise/sunset API request failed');
        return response.json();
      })
      .then(function (data) {
        if (!data.sunrise || !data.sunset) throw new Error('Sunrise/sunset data unavailable');
        var formatTime = function (value) {
          return new Date(value).toLocaleTimeString('en-GB', {
            timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
          }).replace(':', 'h');
        };
        document.getElementById('sun-times').textContent =
          'Sunrise: ' + formatTime(data.sunrise) + ' | Sunset: ' + formatTime(data.sunset);
      })
      .catch(function () {
        document.getElementById('sun-times').textContent = 'Sunrise and sunset unavailable';
      });

    // The webcams are still snapshots updated server-side: reload them every minute.
    document.querySelectorAll('.webcam img').forEach(function (img) {
      var src = img.src;
      setInterval(function () {
        img.src = src + '?t=' + Date.now();
      }, 60000);
    });

    // Grey out past hours and highlight the current one in the visitor's browser.
    var now = Date.now() / 1000;
    document.querySelectorAll('tbody tr').forEach(function (tr) {
      var start = Number(tr.dataset.epoch);
      if (now >= start + 3600) tr.className = 'past';
      else if (now >= start) tr.className = 'now';
    });
  </script>
</body>
</html>
